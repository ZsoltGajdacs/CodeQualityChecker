        <executions><execution>
          <id>project-agent</id>
          <goals><goal>prepare-agent</goal></goals>
          <configuration><destFile>${project.build.directory}/project-coverage.exec</destFile></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
