<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion><parent><groupId>cqc.fixtures.contexts</groupId><artifactId>root</artifactId><version>1.0</version></parent><artifactId>red</artifactId>
  <properties><junit.version>5.13.4</junit.version></properties>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.2.0</version>
    <executions><execution><phase>generate-sources</phase><goals><goal>run</goal></goals><configuration><target>
      <mkdir dir="${project.build.directory}/generated-sources/cqc/sample"/>
      <echo file="${project.build.directory}/generated-sources/cqc/sample/Generated.java">package sample; public class Generated { public static int value() { return 1; } }</echo>
    </target></configuration></execution></executions>
  </plugin><plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
    <executions><execution><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>${project.build.directory}/generated-sources/cqc</source></sources></configuration></execution></executions>
  </plugin></plugins></build>
</project>
